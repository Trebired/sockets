{
  "author": "Miroslav Machynka (Trebired)",
  "config": {
    "organization": {
      "displayName": "Trebired",
      "name": "trebired",
      "website": "https://trebired.com"
    }
  },
  "name": "@trebired/sockets",
  "version": "0.1.0",
  "description": "Socket channels for Trebired apps: one namespace per system with its own connection guard, rooms with permission checks, snapshots and requests, declared inbound events, and revocation, plus a client for browsers and Bun.",
  "type": "module",
  "private": false,
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "import": "./dist/client/index.js",
      "types": "./dist/client/index.d.ts"
    },
    "./server": {
      "import": "./dist/server/index.js",
      "types": "./dist/server/index.d.ts"
    }
  },
  "files": [
    ".trebired/logger/config.ts",
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "bun run prepare:generated && rm -rf dist && tsc -p tsconfig.build.json && bun ./scripts/prepare-dist.mjs",
    "prepare:generated": "bun node_modules/@trebired/code-discipline/dist/cli.js fix imports",
    "prepublishOnly": "bun run typecheck && bun run build && bun run verify:pack && bun run verify:sockets",
    "typecheck": "bun run prepare:generated && tsc --noEmit",
    "verify:pack": "bun ./scripts/verify/pack.mjs",
    "verify:sockets": "bun ./scripts/verify/sockets.mjs"
  },
  "dependencies": {
    "@package/logger-adapter": "npm:@trebired/logger-adapter@^0.8.2",
    "@trebired/utils": "^0.9.9",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@trebired/code-discipline": "^8.0.3",
    "@trebired/configs": "^0.6.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.13.3",
    "socket.io": "^4.8.1",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "sockets",
    "socket.io",
    "realtime",
    "rooms",
    "bun"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Trebired/sockets"
  },
  "homepage": "https://github.com/Trebired/sockets#readme",
  "bugs": {
    "url": "https://github.com/Trebired/sockets/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
